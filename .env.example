# ============================================
# ShroomSync Backend Server Configuration
# Copy this file to .env and fill in your values
# ============================================

# ── Server Configuration ───────────────────
PORT=3000
NODE_ENV=development

# ── Database (MariaDB / MySQL via Prisma) ─
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/shroomsync

# ── MQTT Broker Configuration ──────────────
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=shroomsync-server

# ── CORS Security ──────────────────────────
# Comma-separated list of allowed origins
# Examples: http://localhost:3000,https://dashboard.shroomsync.com
# DO NOT use wildcard (*) in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting Configuration ────────────
# Disabled by default so frontend polling/control is not blocked.
# Set true only if you explicitly want API rate limiting.
RATE_LIMIT_ENABLED=false
# Window time in milliseconds (900000 = 15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window (100 default)
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging Configuration ──────────────────
# Log level: debug, info, warn, error
LOG_LEVEL=debug
# Pretty print logs in console (set to false for JSON logs)
PRETTY_LOG=true

# ── Storage Configuration ──────────────────
FIRMWARE_UPLOAD_DIR=./storage/firmware
TELEMETRY_RETENTION_DAYS=14

# ── Device Status Tracking ─────────────────
# Timeout before marking device offline (milliseconds, default 300000 = 5 minutes)
DEVICE_OFFLINE_TIMEOUT_MS=300000
# How often to check for offline devices (milliseconds, default 30000 = 30 seconds)
DEVICE_STATUS_CHECK_INTERVAL_MS=30000
