# ============================================
# ShroomSync Backend Server Configuration
# ============================================

# Server
PORT=3000
NODE_ENV=development

# MQTT Broker
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=shroomsync-server

# Database (MariaDB / MySQL via Prisma)
DATABASE_URL=mysql://root:password@localhost:3306/shroomsync

# OTA Firmware Storage
FIRMWARE_UPLOAD_DIR=./storage/firmware

# Telemetry Retention (days)
TELEMETRY_RETENTION_DAYS=14
