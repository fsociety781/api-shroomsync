{
  "info": {
    "name": "ShroomSync API",
    "description": "ShroomSync IoT Backend — MQTT Bridge, REST API & Real-time Gateway\n\nBase URL: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://shroomsync.web.id",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "SHROOMSYNC-ESP32-TEST",
      "type": "string"
    },
    {
      "key": "cycleId",
      "value": "sample-cycle-id",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Check server status, uptime, and version."
          }
        }
      ]
    },
    {
      "name": "🔐 Authentication & Onboarding",
      "item": [
        {
          "name": "1. Login — Akun Baru (First Time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"petani_baru\",\n  \"password\": \"PasswordDefault123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login pertama kali dengan password default. Mengembalikan token dan mustSetupProfile: true."
          }
        },
        {
          "name": "2. Complete Onboarding (Ganti Password & Data Diri)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"PasswordDefault123!\",\n  \"newPassword\": \"PasswordRahasiaBaru2026\",\n  \"fullName\": \"Budi Santoso\",\n  \"phoneNumber\": \"081234567890\",\n  \"farmName\": \"Kumbung Berkah Tiram\",\n  \"farmAddress\": \"Desa Sukamaju RT 02 RW 01, Lembang, Bandung Barat\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/complete-onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "complete-onboarding"
              ]
            },
            "description": "Wajib untuk akun baru: ganti password default dan isi data diri lengkap."
          }
        },
        {
          "name": "3. Login — Akun Lama (Normal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"petani_baru\",\n  \"password\": \"PasswordRahasiaBaru2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login normal setelah onboarding selesai. Langsung mengembalikan nextStep: 'dashboard'."
          }
        },
        {
          "name": "4. Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Mengambil data profil akun yang sedang login beserta jumlah device/kumbung yang dimiliki."
          }
        },
        {
          "name": "5. Register Farmer Account (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"petani_baru@gmail.com\",\n  \"username\": \"petani_baru\",\n  \"password\": \"PasswordDefault123!\",\n  \"fullName\": \"Calon Petani Jamur\",\n  \"farmName\": \"Kumbung Jamur Mandiri\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register-farmer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register-farmer"
              ]
            },
            "description": "Membuat akun petani baru dengan password default (status: isFirstLogin=true)."
          }
        }
      ]
    },
    {
      "name": "📱 Device Management",
      "item": [
        {
          "name": "Activate / Pair Device (Input ID or Barcode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"name\": \"Kumbung Barat - Tiram Putih\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/activate",
