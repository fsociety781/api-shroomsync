                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "activate"
              ]
            },
            "description": "Aktivasi perangkat kumbung jamur baru ke akun user melalui scan barcode / input ID."
          }
        },
        {
          "name": "List All Devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices",
